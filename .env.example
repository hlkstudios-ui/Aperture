TMDB_REGION=CA

# AUTHENTICATION CREDENTIALS — replace the blank values before deployment.
# Callback format: https://YOUR-API-DOMAIN/auth/oauth/{provider}/callback
OAUTH_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
OAUTH_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
