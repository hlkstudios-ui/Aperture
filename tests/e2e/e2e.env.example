# Copy this file outside source control and replace every placeholder.
# E2E_RUN_ID determines the exact disposable database and bucket names.
APP_ENV=test
E2E_RUN_ID=local-safety01
STUDIO_DEV_AUTO_LOGIN=false
STUDIO_DEV_ADMIN_EMAIL=

# Never use Aperture's shared development ports (web 3000; API 8000/8001).
E2E_BASE_URL=http://127.0.0.1:13000
E2E_API_ORIGIN=http://127.0.0.1:18001

# The database name and bucket must correspond exactly to E2E_RUN_ID.
DATABASE_URL=postgresql+psycopg://E2E_USER:E2E_PASSWORD@127.0.0.1:5433/aperture_e2e_local_safety01
REDIS_URL=redis://127.0.0.1:6380/14
S3_ENDPOINT=http://127.0.0.1:9100
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=aperture-e2e-local-safety01
S3_REGION=us-east-1
S3_ACCESS_KEY=E2E_ACCESS_KEY
S3_SECRET_KEY=E2E_SECRET_KEY
SESSION_SECRET=replace-with-a-local-e2e-session-secret

# Configure the isolated API and web processes with these same origins/resources.
# E2E_OWNER_TOKEN is intentionally absent; the npm wrapper generates it for each run.
API_ORIGIN=http://127.0.0.1:18001
WEB_ORIGIN=http://127.0.0.1:13000
