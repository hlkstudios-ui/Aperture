{
	admin off
	auto_https off
}

:8080 {
	@studio path /studio /studio/* /api/gateway/admin /api/gateway/admin/* /api/site/brand/logo /api/document-locale /_next/* /favicon.ico

	handle @studio {
		reverse_proxy {$PUBLIC_APP_ORIGIN} {
			header_up Host {$PUBLIC_APP_HOST}
			header_up X-Forwarded-Host {$PUBLIC_APP_HOST}
			header_up -X-Aperture-Public-Host
			header_up -X-Aperture-Public-Origin
			header_up -X-Aperture-Edge-Secret
			header_up X-Aperture-Origin-Secret {$ORIGIN_EDGE_SECRET}
			header_up X-Aperture-Studio-Edge {$STUDIO_EDGE_SECRET}
			header_down -Server
			header_down -X-Powered-By
		}
	}

	handle {
		respond "Not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
	}
}
