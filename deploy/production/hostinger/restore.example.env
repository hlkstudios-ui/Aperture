# Restore labels documented here are entered in the root .env only for an authorized rehearsal.
# Target a newly created, empty database. Never point this at production.
RESTORE_DATABASE_URL=postgresql://DUMMY_restore_user:DUMMY_password@DUMMY_private_host:5432/aperture_restore_DUMMY?sslmode=require
RESTORE_MANIFEST_KEY=postgres/YYYY/MM/DD/YYYYMMDDTHHMMSSZ.manifest.json
RESTORE_CONFIRMATION=RESTORE_TO_ISOLATED_EMPTY_DATABASE
BACKUP_S3_ENDPOINT=https://DUMMY_s3-backup-provider.example.com
BACKUP_S3_REGION=DUMMY_backup_region
BACKUP_S3_BUCKET=DUMMY_aperture-production-backups
BACKUP_S3_ACCESS_KEY=DUMMY_READ_ONLY_BACKUP_ACCESS_KEY
BACKUP_S3_SECRET_KEY=DUMMY_READ_ONLY_BACKUP_SECRET
