# Host-hardening labels documented here are entered in the root .env. Never use a broad SSH source.
EXPECTED_HOSTNAME=DUMMY_aperture-production
SSH_ALLOWED_CIDR=DUMMY_203.0.113.10/32
HOSTINGER_VPS_PROFILE=full
# Provider-labeled plan capacity; do not replace these with df or /proc readings.
HOST_MIN_MEMORY_GB=32
HOST_MIN_DISK_GB=400
HOST_MIN_FREE_DISK_GB=100
# Required only for bootstrap --mode apply.
HOST_HARDENING_CONFIRMATION=HARDEN_HOSTINGER_VPS_WITH_RESTRICTED_SSH
