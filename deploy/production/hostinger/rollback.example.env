# Rollback labels documented here are entered in the root .env only for an approved rehearsal.
HOSTINGER_ROLLBACK_API_IMAGE=dummy.registry.example/aperture-api@sha256:1111111111111111111111111111111111111111111111111111111111111111
HOSTINGER_ROLLBACK_WEB_IMAGE=dummy.registry.example/aperture-web@sha256:1111111111111111111111111111111111111111111111111111111111111111
HOSTINGER_ROLLBACK_BACKUP_IMAGE=dummy.registry.example/aperture-backup@sha256:1111111111111111111111111111111111111111111111111111111111111111
# Required only for --mode execute. Inspect mode never changes the stack.
ROLLBACK_CONFIRMATION=ROLLBACK_HOSTINGER_APPLICATION_TRAFFIC
