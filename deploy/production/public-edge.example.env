# Public, non-secret inputs. Production must use the publicly trusted certificate chain.
SMOKE_WEB_ORIGIN=https://DUMMY_watch.example.com
# Hostinger Caddy routes this /api base to FastAPI and strips the prefix.
SMOKE_API_ORIGIN=https://DUMMY_watch.example.com/api
# Leave unset for publicly trusted production TLS. Local staging may set a private CA file.
# SMOKE_CA_FILE=/absolute/path/to/local-ca.crt
