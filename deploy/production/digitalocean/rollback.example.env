# Non-secret fixture: put these labels in the repository-root .env only during an approved rehearsal.
# Create a short-lived least-privilege DigitalOcean token and revoke it afterward.
DIGITALOCEAN_TOKEN=DUMMY_SHORT_LIVED_OPERATOR_TOKEN
DIGITALOCEAN_APP_ID=11111111-1111-4111-8111-111111111111
# Explicit known-good deployment selected and reviewed by two operators.
DIGITALOCEAN_ROLLBACK_DEPLOYMENT_ID=22222222-2222-4222-8222-222222222222
# Required only for --mode execute. Inspection never changes provider state.
ROLLBACK_CONFIRMATION=ROLLBACK_APPLICATION_TRAFFIC
