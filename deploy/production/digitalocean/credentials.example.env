# APERTURE DIGITALOCEAN PRODUCTION INPUTS
# Copy this file to credentials.local.env. The local file is git-ignored.
# Replace every DUMMY_* value only when you are ready to deploy.
# Never commit, email, or paste the completed local file into a ticket or chat.

# ── Public names ──────────────────────────────────────────────────────────────
# REQUIRED: root DNS zone controlled in DigitalOcean DNS (example: example.com)
DNS_ZONE=DUMMY_example.com
# REQUIRED: customer application hostname
WEB_HOSTNAME=DUMMY_watch.example.com
# REQUIRED: HTTPS MagicDNS name shown by `tailscale status` for the private gateway
ADMIN_WEB_ORIGIN=https://DUMMY_aperture-studio-gateway.example-tailnet.ts.net
# REQUIRED: protected CDN Worker hostname (Cloudflare adjunct; app remains on DigitalOcean)
CDN_HOSTNAME=DUMMY_media.example.com
# ── Source deployment ────────────────────────────────────────────────────────
# REQUIRED: GitHub owner/repository visible to DigitalOcean App Platform
GITHUB_REPOSITORY=DUMMY_owner/aperture
# REQUIRED: protected release branch or immutable release branch
DEPLOY_BRANCH=DUMMY_main

# ── DigitalOcean managed resources (Toronto / tor1) ─────────────────────────
# REQUIRED: existing production PostgreSQL cluster name
POSTGRES_CLUSTER_NAME=DUMMY_aperture-postgres-tor1
# REQUIRED: existing production Valkey cluster name
VALKEY_CLUSTER_NAME=DUMMY_aperture-valkey-tor1
# REQUIRED: globally unique Standard Spaces bucket name
SPACES_BUCKET=DUMMY_aperture-production-media
# SECRET: bucket-scoped Spaces workload key ID
S3_ACCESS_KEY=DUMMY_SPACES_ACCESS_KEY
# SECRET: bucket-scoped Spaces workload secret
S3_SECRET_KEY=DUMMY_SPACES_SECRET_KEY

# ── Application security ─────────────────────────────────────────────────────
# SECRET: generate at least 32 random bytes; do not reuse between environments
SESSION_SECRET=DUMMY_64_CHARACTER_RANDOM_SESSION_SECRET
# SECRET: shared only by App Platform and the private Tailscale gateway; 48+ random bytes
STUDIO_EDGE_SECRET=DUMMY_64_CHARACTER_RANDOM_PRIVATE_STUDIO_EDGE_SECRET
# SECRET: generate at least 32 random bytes; expose only to API and scraper
METRICS_BEARER_TOKEN=DUMMY_64_CHARACTER_RANDOM_METRICS_TOKEN
# SECRET: identical high-entropy HMAC secret injected into API and CDN edge
CDN_SIGNING_SECRET=DUMMY_64_CHARACTER_RANDOM_CDN_SIGNING_SECRET
# SECRET: separate high-entropy secret used only between CDN edge and API origin
CDN_ORIGIN_SECRET=DUMMY_64_CHARACTER_RANDOM_CDN_ORIGIN_SECRET
# SECRET: shared only by the trusted geo-aware edge and API; at least 32 random bytes
GEO_ASSERTION_SECRET=DUMMY_64_CHARACTER_RANDOM_GEO_ASSERTION_SECRET
# REQUIRED AFTER DIGITALOCEAN CREATION: direct App Platform origin used by the geo edge
GEO_EDGE_ORIGIN_WEB=DUMMY_aperture-origin.ondigitalocean.app

# ── Optional customer capabilities ───────────────────────────────────────────
# REQUIRED: choose exactly true or false. Ask requires SceneLens; parties require Community.
FEATURE_SCENE_LENS_ENABLED=true
FEATURE_ASK_MOVIE_ENABLED=true
FEATURE_COMMUNITY_ENABLED=true
FEATURE_WATCH_PARTIES_ENABLED=true
FEATURE_EXPERIMENTAL_RECOMMENDATIONS_ENABLED=true
# REQUIRED FOR DEPLOY: true only after every document in apps/web/content/policies.json
# contains final owner/counsel-approved text. Dummy mode remains false and cannot launch.
POLICY_REQUIRE_APPROVED=false
# REQUIRED: private ClamAV-compatible clamd hostname reachable only by API workloads.
MALWARE_SCANNER_HOST=DUMMY_private_clamd_host
MALWARE_SCANNER_PORT=3310

# ── Stripe billing ───────────────────────────────────────────────────────────
# SECRET: Stripe live secret key; dummy/test values are rejected in deploy mode
STRIPE_SECRET_KEY=sk_test_DUMMY_NO_NETWORK_CALLS
# SECRET: signing secret for the live /api/billing/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_DUMMY_SIGNING_SECRET

# ── Transactional email ──────────────────────────────────────────────────────
# REQUIRED: SMTP server hostname and TLS submission port
SMTP_HOST=DUMMY_smtp.example.com
SMTP_PORT=587
# SECRET: production SMTP username and password
SMTP_USERNAME=DUMMY_SMTP_USERNAME
SMTP_PASSWORD=DUMMY_SMTP_PASSWORD
# REQUIRED: verified sender address with SPF/DKIM/DMARC configured
SMTP_FROM_EMAIL=DUMMY_no-reply@example.com

# ── Monitoring ───────────────────────────────────────────────────────────────
# SECRET: production error-tracking DSN with PII collection disabled
ERROR_TRACKING_DSN=DUMMY_https://public@example.ingest.sentry.io/project

# ── Isolated PostgreSQL backup destination ───────────────────────────────────
# REQUIRED: separate private/versioned Standard Space with lifecycle retention
BACKUP_S3_BUCKET=DUMMY_aperture-production-backups
# SECRET: backup-only key; grant write/list only to the backup Space
BACKUP_S3_ACCESS_KEY=DUMMY_BACKUP_SPACES_ACCESS_KEY
BACKUP_S3_SECRET_KEY=DUMMY_BACKUP_SPACES_SECRET_KEY
# REQUIRED OWNER DECISIONS: evidence targets; configure matching provider policy
BACKUP_RETENTION_DAYS=DUMMY_35
RECOVERY_POINT_OBJECTIVE_HOURS=DUMMY_24
RECOVERY_TIME_OBJECTIVE_HOURS=DUMMY_4
