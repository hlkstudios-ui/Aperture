# Non-secret fixture: copy this exact allowlist to an ignored, temporary restore.local.env
# only for an authorized rehearsal. Never merge it into the repository-root .env.
# Use a newly created, empty, non-production database. Never point this at production.
RESTORE_DATABASE_URL=postgresql://DUMMY_restore_user:DUMMY_password@DUMMY_private_host:25060/aperture_restore_DUMMY?sslmode=require
RESTORE_MANIFEST_KEY=postgres/YYYY/MM/DD/YYYYMMDDTHHMMSSZ.manifest.json
RESTORE_CONFIRMATION=RESTORE_TO_ISOLATED_EMPTY_DATABASE
BACKUP_S3_ENDPOINT=https://tor1.digitaloceanspaces.com
BACKUP_S3_REGION=tor1
BACKUP_S3_BUCKET=DUMMY_aperture-production-backups
BACKUP_S3_ACCESS_KEY=DUMMY_READ_ONLY_BACKUP_SPACES_ACCESS_KEY
BACKUP_S3_SECRET_KEY=DUMMY_READ_ONLY_BACKUP_SPACES_SECRET_KEY
