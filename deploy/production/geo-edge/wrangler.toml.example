name = "aperture-production-geo-edge"
main = "worker.js"
compatibility_date = "2026-08-01"
workers_dev = false
preview_urls = false

[vars]
ORIGIN_WEB = "https://DUMMY_origin.example.com"
CANONICAL_HOST = "DUMMY_watch.example.com"
# Custom domains are fail-closed until this is explicitly changed to true and
# the SITE_DOMAINS namespace below is created, populated, and uncommented.
CUSTOM_DOMAINS_ENABLED = "false"

# Bind the same production namespace to the geo and protected-media Workers.
# Each key is hostname:<lowercase-hostname>; each value is JSON such as
# {"hostname":"watch.customer.example","status":"active"}.
# [[kv_namespaces]]
# binding = "SITE_DOMAINS"
# id = "DUMMY_PRODUCTION_SITE_DOMAINS_NAMESPACE_ID"
# preview_id = "DUMMY_PREVIEW_SITE_DOMAINS_NAMESPACE_ID"

# Define the canonical-host and Cloudflare-for-SaaS wildcard routes only in the
# private copy after the zone ID is known. In the Cloudflare dashboard/API, also
# create exactly one more-specific no-Worker route (no script association) for
# ORIGIN_HOSTNAME/*, STORAGE_HOSTNAME/*, and CDN_HOSTNAME/*. Do not add those
# exclusions here: a Wrangler route in this file would associate the geo Worker.
# The CDN exclusion lets its Worker Custom Domain take precedence over this wildcard.
# [[routes]]
# pattern = "DUMMY_watch.example.com/*"
# zone_id = "DUMMY_CLOUDFLARE_ZONE_ID"
# [[routes]]
# pattern = "*/*"
# zone_id = "DUMMY_CLOUDFLARE_ZONE_ID"

# cloudflare_saas_preflight.py must pass before the owner attests infrastructure
# readiness or enables custom domains in the Hostinger runtime.

# Add GEO_ASSERTION_SECRET, ORIGIN_EDGE_SECRET, and CUSTOM_DOMAIN_EDGE_SECRET
# with `wrangler secret put`. CUSTOM_DOMAIN_EDGE_SECRET must exactly match the
# value injected into the Hostinger web and API runtimes.
# Route the production WEB_HOSTNAME through this Worker after the Hostinger
# origin is healthy. Never configure the public hostname as ORIGIN_WEB.
