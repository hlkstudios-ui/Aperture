name = "aperture-production-geo-edge"
main = "worker.js"
compatibility_date = "2026-08-01"

[vars]
ORIGIN_WEB = "DUMMY_origin.example.com"

# Add GEO_ASSERTION_SECRET and the separate ORIGIN_EDGE_SECRET with `wrangler secret put`.
# Route the production WEB_HOSTNAME through this Worker after the Hostinger
# origin is healthy. Never configure the public hostname as ORIGIN_WEB.
