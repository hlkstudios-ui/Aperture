# APERTURE FREE-TIER STAGING INPUTS
# Copy to credentials.local.env. That file is ignored by Git.
# DUMMY_* values are safe for validation only and cannot pass --mode deploy.

# Render free web services (assigned after creating the Blueprint)
STAGING_WEB_ORIGIN=https://DUMMY_aperture-web.onrender.com
STAGING_API_ORIGIN=https://DUMMY_aperture-api.onrender.com
STAGING_COOKIE_DOMAIN=DUMMY_.onrender.com

# Supabase Free PostgreSQL pooled connection. Keep sslmode=require.
DATABASE_URL=postgresql+psycopg://DUMMY_USER:DUMMY_PASSWORD@DUMMY_HOST:6543/DUMMY_DATABASE?sslmode=require

# Upstash/other TLS Redis free-tier connection.
REDIS_URL=rediss://default:DUMMY_PASSWORD@DUMMY_HOST:6379/0

# Cloudflare R2 S3 API. Configure bucket CORS for STAGING_WEB_ORIGIN.
S3_ENDPOINT=https://DUMMY_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://DUMMY_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=DUMMY_aperture-staging-media
S3_ACCESS_KEY=DUMMY_R2_ACCESS_KEY
S3_SECRET_KEY=DUMMY_R2_SECRET_KEY

# Generate independent values of at least 32 random characters.
SESSION_SECRET=DUMMY_64_CHARACTER_RANDOM_SESSION_SECRET
METRICS_BEARER_TOKEN=DUMMY_64_CHARACTER_RANDOM_METRICS_TOKEN
GEO_ASSERTION_SECRET=DUMMY_64_CHARACTER_RANDOM_GEO_SECRET

# Free SMTP provider. Staging password-reset delivery requires all four values.
SMTP_HOST=DUMMY_smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=DUMMY_SMTP_USERNAME
SMTP_PASSWORD=DUMMY_SMTP_PASSWORD
SMTP_FROM_EMAIL=DUMMY_no-reply@example.com

# Sentry developer/free project DSN; keep PII collection disabled.
ERROR_TRACKING_DSN=DUMMY_https://public@example.ingest.sentry.io/project

# Optional capabilities; use exactly true or false.
FEATURE_SCENE_LENS_ENABLED=true
FEATURE_ASK_MOVIE_ENABLED=true
FEATURE_COMMUNITY_ENABLED=true
FEATURE_WATCH_PARTIES_ENABLED=true
FEATURE_EXPERIMENTAL_RECOMMENDATIONS_ENABLED=true
