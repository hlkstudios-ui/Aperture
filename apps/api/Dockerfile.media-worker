FROM python:3.12.14-alpine3.24 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# FFmpeg is intentionally isolated to the media worker. Keep the public API and
# API-derived one-shot/scene workloads on apps/api/Dockerfile.
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates ffmpeg \
    && addgroup --system aperture \
    && adduser --system --ingroup aperture --home /app aperture
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/requirements.lock ./
COPY apps/api/app ./app
COPY apps/api/migrations ./migrations
COPY apps/api/alembic.ini ./
COPY apps/api/scripts ./scripts
RUN pip install --no-cache-dir --requirement requirements.lock
USER aperture
CMD ["python", "-m", "app.media_worker"]
